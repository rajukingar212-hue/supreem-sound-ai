# Supreem Sound AI — Environment Configuration Example
# Copy this file to .env and configure your values.
# NEVER commit .env with real credentials to version control.

# Application Environment (development | production)
ENVIRONMENT=development

# Server Configuration
PORT=8000
SECRET_KEY=supreem-sound-ai-production-super-secret-key-change-in-prod-2026
CREDENTIAL_ENCRYPTION_KEY=
DATABASE_URL=sqlite:///./storage/supreem_sound.db
# For PostgreSQL in production/Docker:
# DATABASE_URL=postgresql://supreem_user:supreem_password@localhost:5432/supreem_sound_db
REDIS_URL=redis://localhost:6379/0

# Production Security
INITIAL_ADMIN_PASSWORD=

# Google Gemini API (Required for Real AI Scene Understanding)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ElevenLabs Sound Effects API (Required for Real AI Sound Synthesis)
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# API Enforcement Mode
# Set REQUIRE_REAL_API_KEYS=true in production to reject offline fallback
REQUIRE_REAL_API_KEYS=false
ALLOW_OFFLINE_FALLBACK=true

# Audio DSP Normative Standards
SAMPLE_RATE=48000
AUDIO_CHANNELS=2
AUDIO_BIT_DEPTH=24
DURATION_SECONDS=10.0
TARGET_TRUE_PEAK_DBTP=-3.5
MAX_TRUE_PEAK_DBTP=-1.0
MIN_STEM_COUNT=3

# Original Audio Policy
REPLACE_ALL_ORIGINAL_AUDIO=true

# Concurrency & Retries
MAX_RETRIES=3
WORKER_CONCURRENCY=4
AI_REQUEST_CONCURRENCY=2

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000/api
